+    if Path(proc.stdout.strip()).resolve() != root or not (root / "configure.py").is_file():
+        raise ToolError(f"Select the Brawl checkout root, not a parent/subdirectory: {root}")
+    if not (root / "config/RSBE01_01/config.yml").is_file():
